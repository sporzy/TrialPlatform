// Landing page di fairkm.com su Cloudflare Workers: pagine statiche in dist/
// (generate da build.mjs, una per lingua) e worker.js davanti per la scelta della lingua.
{
  "name": "fairkm-landing",
  "account_id": "c900ea12de227d721683fd07a9e403e7",
  "compatibility_date": "2026-10-12",
  "main": "./worker.js",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Limiti dell'iscrizione (iscrizione.mjs): per IP e per indirizzo email, ogni 60 secondi.
  "ratelimits": [
    { "name": "LIMITE_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_EMAIL", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  "routes": [
    { "pattern": "fairkm.com", "custom_domain": true },
    { "pattern": "www.fairkm.com", "custom_domain": true }
  ]
}
