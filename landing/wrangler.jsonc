// Landing page di fairkm.com su Cloudflare Workers: pagine statiche in dist/
// (generate da build.mjs, una per lingua) e worker.js davanti per la scelta della lingua.
{
  "name": "fairkm-landing",
  "account_id": "c900ea12de227d721683fd07a9e403e7",
  "compatibility_date": "2026-10-12",
  "main": "./worker.js",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // App delle gare (Next.js su Render): il Worker le inoltra /races/, /<lingua>/races/ e /_next/.
  // L'indirizzo del servizio fairkm-app-ybrg (render.yaml; Render aggiunge il suffisso al nome), senza barra
  // finale. Vuoto = quei percorsi danno 404. Va cambiato qui, non nella dashboard di Cloudflare:
  // ogni `wrangler deploy` riscrive le variabili con i valori di questo file.
  "vars": { "APP_ORIGIN": "https://fairkm-app-ybrg.onrender.com" },
  // Limiti dell'iscrizione (iscrizione.mjs): per IP e per indirizzo email, ogni 60 secondi.
  "ratelimits": [
    { "name": "LIMITE_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIMITE_EMAIL", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  // Controllo notturno delle fonti (worker.js, scheduled): ogni notte alle 02:30 UTC (03:30 o 04:30 in Italia).
  // Il segreto non sta qui: `wrangler secret put CONTROLLO_SEGRETO`.
  "triggers": { "crons": ["30 2 * * *"] },
  "routes": [
    { "pattern": "fairkm.com", "custom_domain": true },
    { "pattern": "www.fairkm.com", "custom_domain": true }
  ]
}
